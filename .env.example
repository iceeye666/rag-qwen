# 通义千问 API Key（DashScope），在阿里云百炼控制台获取
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选覆盖（默认值即下列内容）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_MODEL=text-embedding-v2
# CHAT_MODEL=qwen-plus
# CHUNK_SIZE=250
# CHUNK_STRIDE=100
# TOP_K=4
# SCORE_THRESHOLD=0.30
# CHROMA_DIR=./storage/chroma

# ---- 向量库后端选择 ----
# chroma（默认）| milvus
# VECTOR_BACKEND=chroma

# ---- Milvus 配置（VECTOR_BACKEND=milvus 时生效）----
# 连接目标解析顺序：MILVUS_URI 优先；未设置则用 MILVUS_HOST:MILVUS_PORT；
# 两者都未设置则回退本地 Milvus Lite 文件 ./storage/milvus.db（无需部署服务）。
# MILVUS_URI=./storage/milvus.db
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530
# Zilliz Cloud 等需要鉴权的服务填写 token，本地/自建可留空
# MILVUS_TOKEN=
# MILVUS_COLLECTION=rag_qwen_docs
# 向量维度，须与 EMBED_MODEL 输出一致：
# text-embedding-v2 → 1536，text-embedding-v3 → 1024，qwen3.7-text-embedding-flash → 1024
# MILVUS_DIM=1536
